# Xcode
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xccheckout
*.moved-aside
*.xcscmblueprint

# Swift Package Manager
.build/
.swiftpm/

# macOS
.DS_Store

# Simulator / device artifacts
*.ipa
*.dSYM
*.dSYM.zip

# Local provider credentials — never committed.
# `backend/config.example.env` is the committed template; the real values go in an ignored file
# next to it. Without these rules a `git add -A` would sweep a live key into history.
.env
.env.*
!.env.example
backend/.env
backend/.env.*
backend/*.local.env

# Local development defaults for Debug builds (backend host + client token).
# The committed template is prompter/Config/Local-Debug.example.xcconfig.
prompter/Config/Local-Debug.xcconfig
