<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Neverblank</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NeverblankInstallationAccess</key>
	<string>$(NEVERBLANK_INSTALLATION_ACCESS)</string>
	<key>RevenueCatPublicKey</key>
	<string>$(REVENUECAT_PUBLIC_KEY)</string>
	<key>NeverblankTermsURL</key>
	<string>$(NEVERBLANK_TERMS_URL)</string>
	<key>NeverblankPrivacyURL</key>
	<string>$(NEVERBLANK_PRIVACY_URL)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Neverblank listens only while Live is on, to transcribe your interview on your iPhone. Audio is never recorded or uploaded.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Neverblank turns speech into text on your iPhone. To detect questions and suggest answers, the text (not the audio) is sent to Neverblank’s AI service.</string>
	<!-- Development defaults, injected from the git-ignored prompter/Config/Local-Debug.xcconfig.
	     Empty when that file is absent, which simply means the app asks you to configure it.
	     These keys exist only in this Debug plist; Info.plist (Release) has neither. -->
	<key>CopilotDevBackendHost</key>
	<string>$(COPILOT_DEV_BACKEND_HOST)</string>
	<key>CopilotDevBackendToken</key>
	<string>$(COPILOT_DEV_BACKEND_TOKEN)</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Neverblank contacts the development backend you run on your own computer, on your local network, to suggest answers. Nothing is sent to it unless you tap Generate.</string>
	<!-- Development only, and deliberately the narrowest exception that works.
	     NSAllowsLocalNetworking permits plain HTTP to local addresses (RFC 1918 and .local) so the
	     phone can reach a backend running on the developer's Mac. It does NOT allow insecure loads to
	     internet hosts: NSAllowsArbitraryLoads stays off, so every public connection still requires
	     HTTPS. See docs/CO_INTERVIEW_AI_PIPELINE.md §10. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UIAppFonts</key>
	<array>
		<string>SpaceGrotesk-Variable.ttf</string>
		<string>Inter-Variable.ttf</string>
		<string>IBMPlexMono-Regular.ttf</string>
		<string>IBMPlexMono-Medium.ttf</string>
		<string>HankenGrotesk-Variable.ttf</string>
		<string>SourceSerif4-Variable.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
