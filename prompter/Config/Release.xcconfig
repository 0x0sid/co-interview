// Release builds (TestFlight / App Store): RevenueCat App Store, real purchases.
//
// Committed. REVENUECAT_API_KEY is the App Store iOS **public** SDK key ("appl_…"); it may be set
// here or in the git-ignored Local-Release.xcconfig (template: Local-Release.example.xcconfig),
// included last so it wins. The Release build fails ("Release safety check" build phase,
// scripts/release-guard.sh) when the key is missing or a Test Store key, when the store mode is not
// app-store, when the production backend URL is missing, or when a backend/provider token is found.
BILLING_STORE_MODE = app-store
REVENUECAT_API_KEY =
// The production backend, as a host: xcconfig treats "//" as a comment, so Info.plist adds https://.
NEVERBLANK_BACKEND_HOST = backend--d7y3w.fly.dev

#include? "Local-Release.xcconfig"
