# Example configuration for the Co-Interview copilot backend.
# Copy to a file your shell sources, or export these directly. **Never commit a real key.**
# Runtime: Node 22 (Jod) or 24 (Krypton). Node 18/20 are past end-of-life.

# Required. Comma-separated bearer tokens the iOS app must present.
# Generate one with:  openssl rand -hex 24
COINTERVIEW_TOKENS=replace-with-a-random-token

# --- Provider credentials (server-side only; never in the app, logs or this repository) ----------
# Leave both empty to run without a provider: the endpoints then answer 503 provider_unconfigured and
# the app shows "answer suggestions are not configured" rather than inventing an answer.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- Gateway and profile -------------------------------------------------------------------------
# openai (default) uses the Responses API with the models below.
# openrouter uses Chat Completions with one of the profiles: speed | balanced | smart | custom.
COPILOT_TEXT_PROVIDER=openai
COPILOT_PROFILE=balanced

# Direct-OpenAI models — verified against OpenAI documentation on 2026-09-16.
COPILOT_DETECTION_MODEL_ID=gpt-5.4-nano
COPILOT_ANSWER_MODEL_ID=gpt-5.4-mini

# OpenRouter example (routing slugs, not display names — verified 2026-09-16):
#   COPILOT_TEXT_PROVIDER=openrouter
#   COPILOT_PROFILE=speed
#   COPILOT_ANSWER_MODEL_ID=nvidia/nemotron-3.5-lightning
#   COPILOT_ANSWER_PROVIDER_ORDER=coreweave/bf16
#   COPILOT_DETECTION_MODEL_ID=google/gemini-2.5-flash-lite
#   COPILOT_DETECTION_PROVIDER_ORDER=google-ai-studio

# --- Generation settings --------------------------------------------------------------------------
# Reasoning stays off for live answers. DeepSeek V4.1 Flash reasons by default and does not accept
# effort "none", so the backend disables it with reasoning:{enabled:false} — see the pipeline doc §2.
COPILOT_REASONING_ENABLED=false
COPILOT_MAX_OUTPUT_TOKENS=700
COPILOT_TEMPERATURE=0.3
# Detection has its own budget, so changing answer length cannot change detector behaviour.
COPILOT_DETECTION_MAX_OUTPUT_TOKENS=300
COPILOT_DETECTION_TEMPERATURE=0

# --- Routing --------------------------------------------------------------------------------------
# false disables BOTH upstream provider failover and application-level model fallback.
COPILOT_ALLOW_FALLBACKS=true
COPILOT_REQUIRE_PARAMETERS=true
COPILOT_DATA_COLLECTION=deny
COPILOT_PIN_PROVIDER_DURING_BENCHMARK=true

# --- Development only -----------------------------------------------------------------------------
# Canned, clearly-labelled answers so the pipeline runs with no credential.
# COINTERVIEW_FAKE=1
# Lets the benchmark harness pin a route per run. Never enable outside local development.
# COINTERVIEW_ALLOW_REQUEST_OVERRIDES=1

# --- Reaching the backend from a physical iPhone ---------------------------------------------------
# 127.0.0.1 on the phone means THE PHONE. Bind to the LAN and point the app at the Mac's address:
#   ipconfig getifaddr en0      ->  e.g. 192.168.1.42
#   HOST=0.0.0.0 node server.mjs
# Then set the app's backend URL to http://192.168.1.42:8787 and the access token to a value from
# COINTERVIEW_TOKENS above. Plain HTTP to a LAN address needs the Debug-only ATS exception described
# in docs/CO_INTERVIEW_AI_PIPELINE.md §10; the Simulator needs none.

# --- Bind address and limits ----------------------------------------------------------------------
# HOST=0.0.0.0 is needed to reach the backend from a physical iPhone on the same network.
HOST=127.0.0.1
PORT=8787
MAX_BODY_BYTES=65536
REQUEST_TIMEOUT_MS=20000

# --- Typed decisions (Jev, TypeSafe System One, through OpenRouter) ---------------------------------
# Jev answers narrow typed questions about the conversation (is the newest speech a new request, a
# continuation, a correction…; which earlier question it belongs to; what an answer needs). It never
# writes text. It is reached through OpenRouter's Decisions API with OPENROUTER_API_KEY above — no
# TypeSafe account. Without that key, decisions are OFF and the existing detector runs alone.
# off | shadow | active. With a key and no value, the default is shadow: the existing detector decides,
# Jev is asked the same thing afterwards, and only the comparison is recorded.
# COPILOT_DECISION_MODE=shadow
# Pinned dated snapshot; ~typesafe/jev-latest resolved to it on 2026-09-24.
# COPILOT_DECISION_MODEL=typesafe/jev-1.13-20260917
# Limited-active for one session: with this on, a session that asks (Debug toggle "Apply Jev decisions")
# gets accepted decisions applied while every other session stays in shadow. Off by default.
# COPILOT_DECISION_SESSION_OPT_IN=1
# Alternative transport: TypeSafe's own API with its own key (then COPILOT_DECISION_MODEL=jev-1.13.0).
# COPILOT_DECISION_TRANSPORT=typesafe
# TYPESAFE_API_KEY=
# Active mode only: which decisions Jev may control (role, parent). Empty = none, whatever the mode.
# COPILOT_DECISION_ACTIVE=
# COPILOT_DECISION_ACTIVE_MIN_CONFIDENCE=0.6
# COPILOT_DECISION_ACTIVE_TIMEOUT_MS=1200
# Shadow calls: deadline per call, attempts (1 retry on 429/529/5xx), concurrency, waiting sessions.
# COPILOT_DECISION_TIMEOUT_MS=8000
# COPILOT_DECISION_MAX_ATTEMPTS=2
# COPILOT_DECISION_MAX_CONCURRENCY=2
# COPILOT_DECISION_MAX_QUEUED=16
